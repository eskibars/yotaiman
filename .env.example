# Copy to .env and adjust.  Every value has a working default.

# --- where local state lives -------------------------------------------------
# cookies.json, cached token, generated audio, service state
# Default: ~/.config/yotaiman
# YOTO_STATE_DIR=./.yoto

# --- the service -------------------------------------------------------------
YOTO_HOST=127.0.0.1
YOTO_PORT=8787
YOTO_DEBUG=false
# Set to true to listen on all interfaces (the API is unauthenticated).
YOTO_ALLOW_REMOTE=false

# --- the daily card ----------------------------------------------------------
# Leave empty to have the service create and remember its own card.
YOTO_DAILY_CARD_ID=
# replace = one story per day; history = keep the last N days as chapters
YOTO_DAILY_MODE=replace
YOTO_HISTORY_DAYS=7

# --- text to speech ----------------------------------------------------------
# Any macOS `say` voice name, e.g. Karen (en_AU), Samantha (en_US),
# Daniel (en_GB), Junior, Fred.
# The generator registry in config.yaml is the primary configuration; this
# variable is the fallback when no config.yaml is present.
YOTO_TTS_VOICE=Karen
YOTO_TTS_COMMAND=say
YOTO_FFMPEG_COMMAND=ffmpeg

# --- generators --------------------------------------------------------------
# The music and speech generators live in config.yaml. Point this at a
# different file to use a different profile.
# YOTO_CONFIG_FILE=./config.yaml

# A local ACE-Step server can require a key; the generator reads it from
# whichever environment variable its config.yaml names.
# ACESTEP_API_KEY=

# --- text generation ---------------------------------------------------------
# auto | template | script | openai
#   template - local writer, no credentials, always works
#   script   - the local llm-call helper (reads the runtime config.yaml)
#   openai   - the OpenAI API, needs OPENAI_API_KEY
YOTO_LLM_BACKEND=auto
YOTO_LLM_MODEL=minimax/MiniMax-M3.1-Flash
# Only needed for the "script" backend: the path to the llm-call helper.
# YOTO_LLM_SCRIPT=/path/to/llm_call.py

# The OpenAI backend is used automatically when this is set.
# OPENAI_API_KEY=
YOTO_OPENAI_MODEL=gpt-4o-mini
